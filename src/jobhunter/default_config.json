    },
    "export": {
        "output_dir": ""
    },
    "appearance": {
        "font_size": 14
    },
    "data": {
        "job_db_path": "data/jobhunter.db",
        "resume_db_path": "data/resume_library.db",
        "library_md_path": "data/resumelibrary.md"
